# Copy this file to .env on the server and set the exact version already in use.
# Do not use LATEST for production worlds.
BEDROCK_VERSION=SET_ME_TO_CURRENT_SERVER_VERSION
COMPOSE_PROJECT_NAME=infra
MC_BACKUP_MAX_AGE_HOURS=26
MC_BACKUP_RETENTION=4
MC_SAVE_QUERY_PATTERN=disabled|paused|hold|not[[:space:]]+saving
MC_DISK_MAX_USED_PERCENT=90
PLAYIT_FAILURE_THRESHOLD=3
PLAYIT_RESTART_COOLDOWN_SECONDS=300
